# hush — Environment Variables (the SCHEMA, generated from hush's real var usage)
#
# This file is the SCHEMA, not a copy. It lists ONLY the vars hush actually consumes, each a
# placeholder + a one-line comment (brain O-02 — generate .env.example, never copy a stale superset).
# Copy to .env (gitignored) and fill in. Values reach a child process via the JOB-9 preference order
# (broker > 0400 file-mount > run-wrapper > NEVER a committed .env). The acceptance test needs ZERO
# secrets — gitleaks scans offline (Assumption 3).

# --- Required ---

# GitHub PAT — used by the github MCP server (.mcp.json) AND the RSI loop's `gh release` version checks.
# Provision: `gh auth token`. Stays a ${VAR} ref in .mcp.json, never a literal (brain P-16).
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# --- Optional: secrets-tooling (only set the ones your task touches) ---

# SOPS+age — the age key file for `hush init --sops` / `sops -d` (brain JOB 6, S-04). Self-generated,
# NO provider account: `age-keygen -o ~/.config/sops/age/keys.txt`. Inline alt: SOPS_AGE_KEY.
SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt

# OpenBao (self-host runtime broker) — address + a SHORT-LIVED token for dynamic-cred golden tasks
# (brain JOB 5, S-07). Boot a dev container in the sandbox; AppRole auth → short-lived token.
# Absent → the dynamic-cred golden task degrades to "assert the plan only" (never hangs).
BAO_ADDR=http://127.0.0.1:8200

# E2B (sandbox isolation for the acceptance flow). Optional — the GH Actions ubuntu runner is the
# documented alt (E2B is NOT a hard gate; brain/PLAN §11).
E2B_API_KEY=e2b_...

# trufflehog `--only-verified` against a SPECIFIC live backend (e.g. AWS S3) — only if verifying a
# named backend (brain JOB 2). Absent → run --only-verified against fixtures only.
# TRUFFLEHOG_AWS_ACCESS_KEY_ID=AKIA...
# TRUFFLEHOG_AWS_SECRET_ACCESS_KEY=...

# RSI Claude half (DEFERRED — chairman directive D8). The deterministic RSI loop runs $0 WITHOUT this.
# Set later to light up the brain-file self-rewrite half: `gh secret set CLAUDE_CODE_OAUTH_TOKEN`.
# CLAUDE_CODE_OAUTH_TOKEN=...
