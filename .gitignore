# wikimem
.wikimem-cache/
node_modules/

# Build artifacts (TypeScript → dist; published to npm via package.json "files", never committed)
dist/
*.tsbuildinfo
.cache/

# Playwright cockpit E2E scratch (G1) — generated by `playwright test`, never committed
test-results/
playwright-report/

# Runlog — component 10 observability output (every CLI/RSI run appends one line
# through sanitize(): secret-shaped strings redacted + URL queries stripped, O-12/P-17).
# TRACKED, not ignored — the HARD override requires logs/runs.jsonl be committed; the
# per-line redaction is what makes committing it safe (0 secret-shaped values, enforced).

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Ephemeral harness state (never commit)
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating

# Obsidian temp files
vault/Untitled*.base

# Secrets — ignore every .env variant, but KEEP the schema file tracked (JOB 1, brain O-01/P-01)
.env*
!.env.example
